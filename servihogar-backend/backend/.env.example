# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# App
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins (no trailing slash)
# Local defaults are built-in if unset; add your Render frontend URL in production:
# CORS_ORIGINS=https://servihogar-frontend.onrender.com,http://localhost:4300
CORS_ORIGINS=http://localhost:4300,http://127.0.0.1:4300,http://localhost:4200,http://127.0.0.1:4200
